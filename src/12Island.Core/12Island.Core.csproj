<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in panel themes and the custom-theme template; see PanelThemes. -->
    <!-- Fixed resource names: a built-in theme's id is its file name (PanelThemes.BuiltInIndex). -->
    <EmbeddedResource Include="Themes\*.json" LogicalName="TwelveIsland.Core.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Templates\theme-template.json" LogicalName="TwelveIsland.Core.Templates.theme-template.json" />
    <!-- Release notes for the What's new window; see ReleaseHistory. The file name is the version. -->
    <EmbeddedResource Include="..\..\releases\*.md" LogicalName="TwelveIsland.Core.Releases.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
